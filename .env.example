# ==============================
# Aplicacion
# ==============================
FLASK_ENV=production
APP_NAME=Business Analytics - Inversiones a Largo Plazo
PORT=5000
DEMO_MODE=false
PREDICTION_HORIZON_DAYS=126
TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL,SPY,QQQ
MARKET_PERIOD=5y

# ==============================
# MySQL
# Local ejemplo:
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/inversion_bi
# En Railway se recomienda:
# DATABASE_URL=${{MySQL.MYSQL_URL}}

# ==============================
# Hugging Face / FinBERT
# Crear token en Hugging Face y guardarlo SOLO como variable de entorno.
HF_TOKEN=
HF_MODEL=ProsusAI/finbert
HF_PROVIDER=hf-inference
HF_TIMEOUT_SECONDS=45
HF_ALLOW_NEUTRAL_FALLBACK=false

# ==============================
# APIs externas
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=Proyecto universitario contacto@example.com
GDELT_MAX_RECORDS=25

# ==============================
# Power BI
# Si se define, Power BI envia el valor como api_key mediante Web.Contents.
PBI_API_KEY=

# ==============================
# Modelo
MODEL_PATH=models/xgb_model.joblib
MODEL_META_PATH=models/xgb_model_meta.json
